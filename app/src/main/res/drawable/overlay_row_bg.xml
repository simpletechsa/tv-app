<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#CC2F6FED" /><corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="?attr/cAccent" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#992F6FED" /><corners android:radius="8dp" /></shape>
    </item>
    <item><shape><solid android:color="#00000000" /></shape></item>
</selector>
