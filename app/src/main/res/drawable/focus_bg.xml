<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="?attr/cFocus" /><corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="?attr/cAccent" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="?attr/cFocus" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="?attr/cRow" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
